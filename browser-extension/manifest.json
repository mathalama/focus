{
  "manifest_version": 3,
  "name": "Mathalama Focus Mode",
  "version": "1.0.0",
  "description": "Block distracting websites during your focus sessions",
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "host_permissions"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Mathalama Focus Mode"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/content/injected.js"],
      "matches": ["*://*/*"]
    }
  ]
}
